echo "Running full secret scan before push..."
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed or not on PATH."
  echo "Install it with: brew install gitleaks (see https://github.com/gitleaks/gitleaks#installing)"
  exit 1
fi

gitleaks detect --source . --redact --verbose --config .gitleaks.toml --log-opts="HEAD"
if [ $? -ne 0 ]; then
  echo "gitleaks found a potential secret in git history. Push blocked."
  echo "If this is a false positive, add an allowlist entry to .gitleaks.toml."
  exit 1
fi

echo "Running type check + format check..."
npm run check
